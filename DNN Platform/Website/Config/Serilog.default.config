{
  "Serilog": {
    "Using": [
      "DotNetNuke.Instrumentation",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Error"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Properties:j}{NewLine}{Exception}",
          "path": "%BASEDIR%/Portals/_default/Logs/log.resources",
          "rollingInterval": "Day",
          "buffered": true, // Needed to allow buffered writes to the log file, which is required for the flushToDiskInterval setting to work.
          "flushToDiskInterval": "00:00:15",
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithDnnSystemInfo" ]
  }
}